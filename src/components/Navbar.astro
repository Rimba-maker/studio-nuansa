---
import { NAV, SITE } from '../data/site';
import { tegelCss } from '../lib/tegel';
const base = import.meta.env.BASE_URL;
---
<header class="fixed inset-x-0 top-0 z-50 h-[64px] border-b-[3px] border-ink bg-botol-deep">
  <div class="mx-auto flex h-full w-full max-w-[1400px] items-center justify-between px-5 md:px-8">
    <a href={base} class="flex items-center gap-3 text-bone">
      <span class="block h-8 w-8 shrink-0 border border-ink" style={tegelCss('kunci', 'botol', 32)} aria-hidden="true"></span>
      <span class="font-display text-xl leading-none tracking-tight">{SITE.name}</span>
    </a>

    <nav id="nav-menu" aria-label="Navigasi utama"
      class="fixed inset-0 top-[64px] hidden flex-col items-start justify-center gap-2 bg-botol-deep px-8 md:static md:flex md:flex-row md:items-center md:gap-9 md:bg-transparent md:px-0">
      {NAV.map((item) => (
        <a href={item.href} class="py-2 font-display text-4xl text-bone transition-colors hover:text-ochre md:font-sans md:text-sm md:font-medium md:tracking-wide">
          {item.label}
        </a>
      ))}
      
    </nav>

    <div class="flex items-center gap-3">
      <a href="#contact" class="btn btn-ochre !min-h-[44px] !px-4 !py-2 !text-sm md:!px-5 md:!py-2.5"><span class="md:hidden">Konsultasi</span><span class="hidden md:inline">Mulai Konsultasi</span></a>
      <button id="menu-btn" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-menu"
        class="flex h-11 w-11 items-center justify-center text-bone md:hidden">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('nav-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mq = window.matchMedia('(min-width: 768px)');

  function setOpen(open: boolean) {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    menu?.classList.toggle('hidden', !open);
    menu?.classList.toggle('flex', open);
    menuIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (!mq.matches) setOpen(false); }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mq.matches) setOpen(false); });
  mq.addEventListener('change', (e) => {
    if (e.matches) { menu?.classList.remove('hidden'); menu?.classList.add('flex'); document.body.style.overflow = ''; }
    else setOpen(false);
  });
</script>
