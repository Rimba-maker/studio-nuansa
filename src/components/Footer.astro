---
import Tegel from './ui/Tegel.astro';
import { SITE } from '../data/site';
---
<footer class="bg-ink text-bone">
  <Tegel pattern="kunci" palette="botol" size={96} class="h-24 border-y-[3px] border-ink" />
  <div class="mx-auto grid max-w-[1400px] gap-12 px-5 py-20 md:grid-cols-12 md:px-8">
    <div class="md:col-span-6">
      <p class="font-display text-4xl md:text-5xl">{SITE.name}</p>
      <p class="mt-5 max-w-[26ch] font-display text-2xl text-bone/80 md:text-3xl">{SITE.tagline}</p>
      <p class="mt-4 text-bone/60 italic">{SITE.footerLine}</p>
    </div>

    <div class="md:col-span-3">
      <h2 class="label-caps mb-5 font-sans text-bone/55">Office</h2>
      <address class="leading-relaxed text-bone/85">
        {SITE.address.map((l) => (<span class="block">{l}</span>))}
        <span class="mt-4 block">{SITE.hours}</span>
      </address>
    </div>

    <div class="md:col-span-3">
      <h2 class="label-caps mb-5 font-sans text-bone/55">Connect</h2>
      <ul class="space-y-2 text-bone/85">
        <li>Instagram <span class="text-bone/55">{SITE.instagram}</span></li>
        <li>Pinterest <span class="text-bone/55">moodboards</span></li>
        <li>Behance <span class="text-bone/55">project portfolio</span></li>
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-[1400px] px-5 md:px-8">
    <div class="flex flex-col gap-3 border-t border-bone/15 py-8 text-sm text-bone/60 md:flex-row md:justify-between">
      <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p>Featured in {SITE.press.join(', ')}</p>
      <p>Foto: Pexels</p>
    </div>
  </div>
</footer>
