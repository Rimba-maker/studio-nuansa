---
import '../styles/global.css';
import '@fontsource/young-serif/400.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props { title?: string; description?: string; }
const { title = SITE.title, description = SITE.description } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ? new URL(base, Astro.site).href : base;
const ogImage = new URL('og-image.png', site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${site}#studio`,
      name: SITE.name,
      description,
      url: site,
      image: ogImage,
      email: SITE.email,
      telephone: SITE.whatsapp,
      foundingDate: String(SITE.founded),
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.address[0],
        addressLocality: 'Jakarta Selatan',
        postalCode: '12190',
        addressCountry: 'ID',
      },
      areaServed: 'Indonesia',
      makesOffer: ['Full Interior Design', 'Design Consultation', 'E-Design'],
    },
    {
      '@type': 'Person',
      name: 'Wendy Setiawan',
      jobTitle: 'Founder & Principal Designer',
      worksFor: { '@id': `${site}#studio` },
    },
    { '@type': 'CreativeWork', name: 'Studio Nuansa — Selected Projects', creator: { '@id': `${site}#studio` } },
  ],
};
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f261f" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={SITE.keywords} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="min-h-screen flex flex-col pt-[64px]">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-ochre focus:px-4 focus:py-3 focus:text-ink">Lewati ke konten</a>
		<Navbar />
		<main id="main" class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
